# Copy to .env for local development. NEVER commit the real file.
#
# Your own cig.chat bot token: cig.chat -> your bot -> Settings -> API.
# One token controls exactly one bot.
CIGCHAT_API_TOKEN=

# Recommended while trying things out: every write becomes a no-op that
# reports what it would have sent.
# CIGCHAT_DRY_RUN=true

# Refuse any broadcast above this audience size. 0 = no cap.
# CIGCHAT_MAX_BROADCAST_RECIPIENTS=500

# Narrow the tool surface: all | dynamic | comma-separated toolset ids.
# CIGCHAT_TOOLSETS=core,subscribers,flow

# Risk tiers to expose: read,write,send,broadcast,destructive
# CIGCHAT_ALLOW=read,write
