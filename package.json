{
  "name": "@cig-chat/mcp",
  "version": "0.2.0",
  "description": "MCP server for the cig.chat API — drive subscribers, flows, broadcasts, WhatsApp templates and the shop from any MCP client.",
  "keywords": [
    "mcp",
    "modelcontextprotocol",
    "cig.chat",
    "cigchat",
    "whatsapp",
    "chatbot",
    "marketing-automation"
  ],
  "homepage": "https://www.cig.chat/mcp",
  "bugs": "https://github.com/eyalbarash/cig-chat-mcp/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eyalbarash/cig-chat-mcp.git"
  },
  "license": "MIT",
  "author": "Dialogue Online Services LTD",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tools.json": "./docs/tools.json"
  },
  "bin": {
    "cigchat-mcp": "./dist/cli.js"
  },
  "files": [
    "dist",
    "docs/tools.json",
    "docs/TOOLS.md",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "spec:pull": "tsx scripts/pull-spec.ts",
    "gen": "tsx scripts/gen.ts",
    "build": "tsup",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "prettier": "^3.4.2",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
